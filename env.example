# انسخي هذا الملف باسم .env محليًا إذا حبيتِ (اختياري للتطوير المحلي)
# في Railway/Render، تضيفين هذي المتغيرات من لوحة التحكم مباشرة (Variables tab)

# سر توقيع الـJWT — غيّريه لقيمة عشوائية طويلة وسرّية في الإنتاج
JWT_SECRET=غيّري_هذي_القيمة_لشي_عشوائي_وطويل_وسري

# رابط قاعدة البيانات — Railway/Render يعطونه تلقائيًا عند إضافة PostgreSQL
# محليًا يمكن تتركيه فاضي وبيستخدم SQLite تلقائيًا
DATABASE_URL=

# نطاق الفرونت إند المسموح له بالاتصال (لتقييد CORS في الإنتاج)
# مثال: https://etijahak.vercel.app
# اتركيه * أثناء التطوير المحلي فقط
FRONTEND_ORIGINS=*

# مفتاح Anthropic API - اختياري، يفعّل ميزة "اكتبي هدفك الخاص بالذكاء الاصطناعي"
# بدون هذا المفتاح، الموقع يشتغل عادي بالقائمة الثابتة (31 هدف) بدون أي مشكلة
ANTHROPIC_API_KEY=

# رابط الفرونت إند - يُستخدم لإعادة التوجيه بعد ربط GitHub/LinkedIn
FRONTEND_URL=http://127.0.0.1:5500

# GitHub OAuth App
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://127.0.0.1:8000/auth/github/callback

# LinkedIn App (Sign In with OpenID Connect)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://127.0.0.1:8000/auth/linkedin/callback
